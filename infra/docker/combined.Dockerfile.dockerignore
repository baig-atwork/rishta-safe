# Context is the repository root. Keep history, documents, dependency folders, build output and local state out of it, so the image
# installs from the lockfiles and builds from source only. BuildKit reads this file because it sits next to the Dockerfile and is
# named <dockerfile>.dockerignore.

.git
.github
docs
infra/bicep
infra/scripts
**/node_modules
**/.next
**/.next-*
**/.venv
**/__pycache__
**/*.pyc
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.hypothesis
**/.coverage
**/htmlcov
**/coverage
**/playwright-report
**/test-results
**/*.tsbuildinfo
frontend/out
frontend/next-env.d.ts
frontend/screenshots

# Secrets and local configuration
**/.env
**/.env.*

# Not part of the runtime image (the frontend's tests/ stays: next build type-checks every file the tsconfig includes)
backend/tests
backend/scripts
backend/openapi.json
