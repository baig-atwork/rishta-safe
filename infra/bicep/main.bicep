// Rishta Safe demo on Azure App Service for Containers (Linux). Subscription scope: creates ONE resource group,
// rg-bayan-demo-<region>, and deploys everything for Rishta Safe into it (modules/bayan.bicep): a Basic container registry, a
// user-assigned identity with AcrPull, one Basic (B1) Linux App Service plan, and two web apps on that plan, bayan-api-<suffix>
// and bayan-web-<suffix>, each running one image pulled with the managed identity.
//
// WHY APP SERVICE AND NOT CONTAINER APPS (ADR 0187): the Free Trial subscription allows one Container Apps environment in the
// whole subscription and another project holds it (ADR 0186). Rishta Safe shares nothing with that project.
//
// The api is NOT internal-only on this design: App Service Basic has no virtual network or private endpoint, so bayan-api has a
// public https address. It is token-guarded and serves synthetic data only (ADR 0187).
//
// Phases, each idempotent: (1) group, registry, identity, AcrPull, plan: no images needed. (2) deployApi: the api app, which
// needs its image in the registry. (3) deployWeb: the web app, which needs the web image and the api's address.
// scripts/deploy.ps1 runs them in order.

targetScope = 'subscription'

// ---- where ------------------------------------------------------------------------------------------------------------

// An allowed-list on purpose: the region decides the resource group name, and a typo must not create a stray group.
@description('Azure region of everything Rishta Safe owns. The resource group is named rg-bayan-demo-<region>.')
@allowed([
  'uaenorth'
  'germanywestcentral'
])
param location string = 'uaenorth'

// ---- what -------------------------------------------------------------------------------------------------------------

@description('Create the api web app. Needs apiImage in the registry.')
param deployApi bool = false

@description('Create the web app as well. Needs webImage in the registry; implies the api app.')
param deployWeb bool = false

@description('Full image reference of the api, for example acrbayan....azurecr.io/bayan-api:<tag>.')
param apiImage string = ''

@description('Full image reference of the web app.')
param webImage string = ''

@secure()
@description('Session secret of the api (BAYAN_SESSION_SECRET). 64 hex characters, generated by deploy.ps1 and kept in infra/.secrets/. Needed when an app is deployed.')
param sessionSecret string = ''

@description('Object id of the signed-in operator. When set, that user gets AcrPush on the registry so local pushes do not depend on Owner implying it.')
param operatorPrincipalId string = ''

@description('GitHub account that owns the repository, exactly as GitHub shows it (OIDC subjects are case-sensitive). Empty: no deployer identity or federated credential is created.')
param githubOwner string = ''

@description('GitHub repository name.')
param githubRepo string = 'bayan'

@description('Numeric GitHub owner id (gh api repos/OWNER/REPO --jq .owner.id). With githubRepoId it selects the IMMUTABLE subject GitHub issues for repositories created after 15 July 2026. Both or neither.')
param githubOwnerId string = ''

@description('Numeric GitHub repository id (gh api repos/OWNER/REPO --jq .id).')
param githubRepoId string = ''

var tags = {
  project: 'bayan'
  env: 'demo'
  managedBy: 'bicep'
  data: 'synthetic-only'
}

resource rg 'Microsoft.Resources/resourceGroups@2025-04-01' = {
  name: 'rg-bayan-demo-${location}'
  location: location
  tags: tags
}

module bayan 'modules/bayan.bicep' = {
  name: 'bayan'
  scope: rg
  params: {
    location: location
    tags: tags
    deployApi: deployApi
    deployWeb: deployWeb
    apiImage: apiImage
    webImage: webImage
    sessionSecret: sessionSecret
    operatorPrincipalId: operatorPrincipalId
    githubOwner: githubOwner
    githubRepo: githubRepo
    githubOwnerId: githubOwnerId
    githubRepoId: githubRepoId
  }
}

output resourceGroupName string = rg.name
output location string = rg.location
output acrName string = bayan.outputs.acrName
output acrLoginServer string = bayan.outputs.acrLoginServer
output appsIdentityId string = bayan.outputs.appsIdentityId
output planName string = bayan.outputs.planName
output deployerClientId string = bayan.outputs.deployerClientId
output apiAppName string = bayan.outputs.apiAppName
output webAppName string = bayan.outputs.webAppName
@description('Public host of bayan-api (empty until it is deployed).')
output apiHostName string = bayan.outputs.apiHostName
@description('Public host of bayan-web (empty until it is deployed).')
output webHostName string = bayan.outputs.webHostName
