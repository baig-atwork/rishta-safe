# Backend base URL the Next route handler proxies /api/v1/* to (server-side only).
BAYAN_API_URL=http://localhost:8000
# Set to 1 to serve typed fixtures instead of calling the backend (works at runtime; no rebuild needed).
BAYAN_MOCK=1
# Same switch under the public name from the build brief; the server treats either as on.
NEXT_PUBLIC_BAYAN_MOCK=1
# Upstream timeouts in milliseconds.
BAYAN_API_TIMEOUT_MS=8000
