{
  "name": "bayan-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Rishta Safe couple-result companion: Next.js 16 frontend (synthetic data prototype, not a medical device).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "node scripts/e2e-real.mjs",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts",
    "shots": "node scripts/capture-shots.mjs",
    "design:lint": "npx --yes @google/design.md lint ../docs/design/v2/DESIGN.md"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@tanstack/react-query": "5.108.0",
    "clsx": "2.1.1",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
