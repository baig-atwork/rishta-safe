        "items": [],
        "icon_array": null,
        "tone": "neutral",
        "numbers": []
      },
      {
        "kind": "paragraph",
        "text": "اسکریننگ کا نتیجہ امکان کے بارے میں ہوتا ہے۔ یہ تشخیص نہیں ہے۔ اس کا مطلب یہ نہیں کہ کوئی فرد بیمار ہے۔",
        "items": [],
